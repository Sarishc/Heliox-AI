# Heliox Frontend Environment Configuration
# Copy to .env.local: cp .env.local.example .env.local

# =============================================================================
# API Configuration (REQUIRED in production)
# =============================================================================
# Local dev default:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production: set to your API URL
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# =============================================================================
# Dev-only: Demo bootstrap (NEVER set in production)
# =============================================================================
# Used only for "Try demo" button in local development.
# Must match ADMIN_API_KEY in backend .env when running demo seed.
# Generate with: openssl rand -hex 24
# Leave unset in production - demo uses different auth flow.
# NEXT_PUBLIC_DEV_ADMIN_API_KEY=
