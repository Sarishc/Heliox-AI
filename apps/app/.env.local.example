# Heliox Frontend Environment Configuration
# Copy this file to .env.local and update values

# API Configuration (REQUIRED)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Development Only - Remove in production
# This key is used for automatic dev environment bootstrap
NEXT_PUBLIC_DEV_ADMIN_API_KEY=dev-admin-key-change-me

# Production Configuration
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
# Do NOT set NEXT_PUBLIC_DEV_ADMIN_API_KEY in production
