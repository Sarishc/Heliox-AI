# Heliox Backend Environment Configuration
# Copy to .env and set required values before running
#   cp .env.example .env
#   # Edit .env and set SECRET_KEY (required)

# =============================================================================
# REQUIRED - Application will not start without these
# =============================================================================

# JWT signing key - MUST be set. Generate with: openssl rand -hex 32
SECRET_KEY=

# =============================================================================
# Database & Redis (defaults work for local docker-compose)
# =============================================================================

ENV=dev
LOG_LEVEL=INFO

# For local dev with docker-compose, these defaults work:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/heliox
# REDIS_URL=redis://redis:6379/0
# For standalone or production, set explicitly:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/heliox

# REQUIRED — app refuses to start without a working Redis connection.
# Redis is a hard dependency for rate limiting, brute-force protection, and
# token blacklisting. There is no silent fallback.
#
# Local dev (docker-compose):
# REDIS_URL=redis://redis:6379/0
#
# AWS ElastiCache (transit_encryption_enabled = true → must use rediss://):
# REDIS_URL=rediss://your-cluster.abc123.cache.amazonaws.com:6379
#
# The Terraform output `module.redis.redis_url` generates the correct value.
REDIS_URL=

# =============================================================================
# Admin API Key (optional - for scripts, demo seed, CI)
# =============================================================================
# Used by admin endpoints when RBAC platform admin is not available.
# Generate with: openssl rand -hex 24
# Leave empty to use platform admin (is_platform_admin) only.
ADMIN_API_KEY=

# =============================================================================
# CORS (required in production)
# =============================================================================
CORS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# =============================================================================
# Encryption key — REQUIRED in production/staging
# =============================================================================
# Used for:
#   • Encrypting OAuth access/refresh tokens at rest (oauth_identities table)
#   • Encrypting cloud integration credentials at rest (integrations table)
#
# REQUIRED: production and staging will refuse to start without this.
# In dev a temporary key is auto-generated per process (tokens lost on restart).
#
# Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Store securely: AWS Secrets Manager, GCP Secret Manager, or ECS task secrets.
# Never commit this value. Rotate with: python scripts/rotate_oauth_keys.py
INTEGRATIONS_ENCRYPTION_KEY=

# Slack (optional - for alerts)
SLACK_WEBHOOK_URL=
DAILY_SUMMARY_HOUR=9
TIMEZONE=UTC

# =============================================================================
# Stripe (optional - for billing)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_ENTERPRISE=
# Stripe Billing Meters (usage-based billing). Empty = skip export for that metric.
# Create meters in Stripe Dashboard, then set event_name here (e.g. heliox_api_requests).
STRIPE_METER_API_REQUESTS=
STRIPE_METER_INGESTION=
STRIPE_METER_GPU_NODES=
STRIPE_METER_SEATS=

# =============================================================================
# Google OAuth (optional)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# API base URL (for SAML ACS, OAuth callbacks). Set in production.
API_BASE_URL=http://localhost:8000

# =============================================================================
# Email - Transactional email via Resend (optional but REQUIRED for auth flows)
# =============================================================================
# Get API key from https://resend.com
# If not set:
#   - forgot-password endpoint returns HTTP 503 (users cannot reset their password)
#   - resend-verification endpoint returns HTTP 503
#   - register endpoint proceeds but no verification email is sent
# For production deployments, RESEND_API_KEY must be set.
RESEND_API_KEY=
# Verified sender address in Resend (must match a verified domain)
EMAIL_FROM=Heliox Alerts <alerts@heliox.ai>

# =============================================================================
# AWS Cost Explorer integration (optional)
# =============================================================================
# These are per-integration config values set via the Integrations UI, not global env vars.
# boto3 SDK is always installed (see requirements.txt).
# Required IAM permissions: ce:GetCostAndUsage, sts:GetCallerIdentity

# =============================================================================
# Sentry (optional - error tracking)
# =============================================================================
# Get DSN from https://sentry.io project settings. Empty = disabled.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=  # Defaults to ENV (dev/staging/production)
# SENTRY_RELEASE=      # Git SHA or version (e.g. from CI). Enables release tracking.

# =============================================================================
# Other
# =============================================================================
API_V1_PREFIX=/api/v1
USAGE_METERING_SAMPLE_RATE=1.0
# HELIOX_PLUGINS was removed — cloud integrations are configured via the
# /integrations UI (AWS Cost Explorer, GCP BigQuery, Azure Cost Management).

# =============================================================================
# Operational checklist
# =============================================================================
# Run GET /api/v1/admin/config-health (with ADMIN_API_KEY header) to verify:
#   - stripe: true/false     → billing endpoints work
#   - email: true/false      → auth email flows work
#   - aws_available: true    → boto3 installed (should always be true)
#   - google_oauth: true     → Google login works
